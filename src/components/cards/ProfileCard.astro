---
import { site } from '../../config/site';
import { withBase } from '../../utils/url';
import Icon from '../Icon.astro';

const { author } = site;
---

<article class="profile">
  {author.avatar && (
    <img
      class="avatar"
      src={withBase(author.avatar)}
      alt={`${author.name} avatar`}
      width="108"
      height="108"
      loading="eager"
    />
  )}
  <h2>{author.name}</h2>
  <p class="handle">{author.handle}</p>
  <p class="role">
    <Icon name="sparkle" size={16} /> {author.role}
  </p>
</article>

<style>
  .profile {
    display: grid;
    justify-items: end;
    text-align: right;
  }

  .avatar {
    width: 108px;
    height: 108px;
    margin-bottom: var(--space-md);
    border: var(--rule-hair) solid var(--color-rule-strong);
    border-radius: 50%;
    object-fit: cover;
  }

  h2 {
    font-size: var(--text-xl);
    font-weight: 600;
  }

  .handle {
    margin-top: var(--space-3xs);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .role {
    max-width: 30ch;
    margin-top: var(--space-sm);
    font-size: var(--text-sm);
    line-height: 1.6;
    text-align: right;
  }

  /* The icon sits inline at the start of the first line, whatever the alignment. */
  .role :global(svg) {
    display: inline-block;
    margin-right: var(--space-xs);
    vertical-align: -0.2em;
    color: var(--color-accent);
  }

  @media (max-width: 60rem) {
    .profile {
      justify-items: center;
      text-align: center;
    }

    .role {
      text-align: center;
    }
  }
</style>
