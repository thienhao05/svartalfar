---
import { statusLabels, type Project } from '../../data/projects';
import { repoLabel } from '../../utils/repo';
import { tagColour } from '../../utils/tags';
import { withBase } from '../../utils/url';
import FormattedDate from '../FormattedDate.astro';
import Icon from '../Icon.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, description, date, icon, status, stack, repo } = project.data;
const shown = stack.slice(0, 3);
const more = stack.length - shown.length;
---

<article class="card">
  <h2>
    <Icon name={icon} size={20} />
    <a href={withBase(`/projects/${project.id}/`)}>{title}</a>
  </h2>
  <p class="desc">{description}</p>
  <div class="foot">
    <span class="meta">
      <FormattedDate date={date} />
      <span class={`status ${status}`}>{statusLabels[status]}</span>
      {repo && (
        <a class="repo" href={repo} target="_blank" rel="noopener noreferrer">
          <Icon name="github" size={13} /> {repoLabel(repo)}
        </a>
      )}
    </span>
    {shown.length > 0 && (
      <ul class="tags" aria-label="Stack">
        {shown.map((t) => (
          <li class="chip hashtag" style={`--tag: var(--tag-${tagColour(t)})`}>
            {t}
          </li>
        ))}
        {more > 0 && <li class="more">+{more}</li>}
      </ul>
    )}
  </div>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-lg);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-card);
    background: transparent;
    transition:
      border-color var(--dur-short) var(--ease-out),
      background-color var(--dur-short) var(--ease-out),
      transform var(--dur-short) var(--ease-out);
  }

  .card:hover,
  .card:focus-within {
    border-color: var(--color-accent);
    background: color-mix(in oklab, var(--color-accent) 6%, transparent);
    transform: translateY(-2px);
  }

  h2 {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--text-md);
    font-weight: 600;
    line-height: var(--lh-snug);
  }

  h2 :global(svg) {
    flex: none;
    color: var(--color-accent);
  }

  /* The whole card is the link: the title's anchor stretches over it. */
  h2 a {
    text-decoration: none;
  }

  h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .desc {
    color: var(--color-ink-2);
    font-size: var(--text-sm);
    line-height: var(--lh-copy);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .foot {
    display: grid;
    gap: var(--space-xs);
    margin-top: var(--space-xs);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-md);
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  /* Sits above the card-wide link so it stays clickable on its own. */
  .repo {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    color: var(--color-ink-2);
    text-decoration: none;
  }

  .repo:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .status::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: var(--space-xs);
    border-radius: 50%;
    background: var(--color-muted);
    vertical-align: 0.05em;
  }

  .status.active::before {
    background: var(--tag-1);
  }

  .status.done::before {
    background: var(--tag-2);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .more {
    color: var(--color-muted);
    font-size: var(--text-xs);
  }
</style>
