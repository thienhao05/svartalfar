---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import Icon from '../../components/Icon.astro';
import MermaidRenderer from '../../components/knowledge/MermaidRenderer.astro';
import Toc from '../../components/knowledge/Toc.astro';
import { getProjects, statusLabels } from '../../data/projects';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { countWords, readingMinutes } from '../../utils/content';
import { repoLabel } from '../../utils/repo';
import { tagColour } from '../../utils/tags';
import { buildToc } from '../../utils/toc';
import { withBase } from '../../utils/url';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { title, description, date, updated, status, icon, stack, repo, demo } = project.data;
const { Content, headings } = await render(project);
const toc = buildToc(headings);
const words = countWords(project.body ?? '');
const minutes = readingMinutes(project.body ?? '');
const nf = new Intl.NumberFormat('en-GB');
---

<BaseLayout title={title} description={description} type="article">
  <div class:list={['shell', 'frame', { solo: toc.length === 0 }]}>
    <article class="article">
      <a class="back" href={withBase('/projects/')}>
        <Icon name="arrow-left" size={14} /> All projects
      </a>

      <header class="head">
        <h1 data-pagefind-meta="title">
          <Icon name={icon} size={28} />
          {title}
        </h1>
        <p class="lede">{description}</p>

        <div data-pagefind-ignore>
          <ul class="facts">
            <li>
              <Icon name="calendar" size={14} />
              <FormattedDate date={date} />
            </li>
            {updated && updated > date && (
              <li>
                <Icon name="pencil" size={14} />
                <span>
                  Updated <FormattedDate date={updated} />
                </span>
              </li>
            )}
            <li>
              <Icon name="text" size={14} /> {nf.format(words)} words
            </li>
            <li>
              <Icon name="book" size={14} /> {minutes} min read
            </li>
            <li class={`status ${status}`}>{statusLabels[status]}</li>
          </ul>

          {(repo || demo) && (
            <ul class="links">
              {repo && (
                <li>
                  <a class="chip" href={repo} target="_blank" rel="noopener noreferrer">
                    <Icon name="github" size={14} /> {repoLabel(repo)}
                  </a>
                </li>
              )}
              {demo && (
                <li>
                  <a class="chip" href={demo} target="_blank" rel="noopener noreferrer">
                    <Icon name="external" size={14} /> Live demo
                  </a>
                </li>
              )}
            </ul>
          )}

          {stack.length > 0 && (
            <ul class="stack" aria-label="Stack">
              {stack.map((t) => (
                <li class="chip hashtag" style={`--tag: var(--tag-${tagColour(t)})`}>
                  {t}
                </li>
              ))}
            </ul>
          )}
        </div>
      </header>

      <div class="prose">
        <Content />
      </div>
    </article>

    {toc.length > 0 && (
      <aside class="toc-rail" aria-label="Reading tools" data-pagefind-ignore>
        <Toc items={toc} />
      </aside>
    )}
  </div>
  <MermaidRenderer />
</BaseLayout>

<style>
  .solo {
    grid-template-columns: minmax(0, var(--col-main));
    justify-content: center;
  }

  .article {
    min-width: 0;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: 32px;
    margin-bottom: var(--space-md);
    color: var(--color-muted);
    font-size: var(--text-xs);
    text-decoration: none;
  }

  .back:hover {
    color: var(--color-accent);
  }

  .head {
    display: grid;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-lg);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  h1 {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    font-size: var(--text-display);
    font-weight: 500;
    letter-spacing: var(--tracking-display);
    line-height: var(--lh-heading);
  }

  h1 :global(svg) {
    flex: none;
    color: var(--color-accent);
  }

  .lede {
    max-width: 64ch;
    color: var(--color-ink-2);
    font-size: var(--text-md);
    line-height: var(--lh-copy);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .facts {
    gap: var(--space-3xs) var(--space-md);
    margin-bottom: var(--space-sm);
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  .facts li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .status::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-muted);
  }

  .status.active::before {
    background: var(--tag-1);
  }

  .status.done::before {
    background: var(--tag-2);
  }

  .links,
  .stack {
    gap: var(--space-2xs) var(--space-xs);
    margin-bottom: var(--space-xs);
  }

  .links .chip {
    min-height: 26px;
    padding: 0 var(--space-sm);
    font-size: 0.75rem;
  }

  .stack .chip {
    cursor: default;
  }

  .toc-rail {
    position: sticky;
    top: calc(var(--nav-height) + var(--space-xl));
    max-height: calc(100dvh - var(--nav-height) - var(--space-2xl));
    overflow-y: auto;
  }

  @media (max-width: 60rem) {
    .toc-rail {
      display: none;
    }
  }
</style>
