---
import ViewPage from '../../../components/knowledge/ViewPage.astro';
import { getKnowledge } from '../../../data/knowledge';
import { groupSeries } from '../../../utils/content';
import { withBase } from '../../../utils/url';

const groups = groupSeries(await getKnowledge());
const max = Math.max(1, ...groups.map((g) => g.entries.length));
const SHOWN = 5;
const day = (d: Date) => d.toISOString().slice(0, 10);
---

<ViewPage
  view="series"
  title="Series"
  note="Entries that belong together, in the order they are meant to be read."
>
  {groups.length > 0 ? (
    <div class="grid">
      {groups.map((g) => (
        <article class="series" id={g.slug}>
          <header>
            <h2>{g.name}</h2>
            <p class="count">
              {g.entries.length} published
              <span class="bar" aria-hidden="true">
                <span style={`width: ${(g.entries.length / max) * 100}%`} />
              </span>
            </p>
          </header>
          <ol>
            {g.entries.slice(0, SHOWN).map((e, i) => (
              <li>
                <span class="n">{String(i + 1).padStart(2, '0')}</span>
                <a href={withBase(`/knowledge/${e.id}/`)} lang={e.data.lang}>
                  {e.data.title}
                </a>
                <time datetime={e.data.date.toISOString()}>{day(e.data.date)}</time>
              </li>
            ))}
          </ol>
          {g.entries.length > SHOWN && (
            <details>
              <summary>View {g.entries.length - SHOWN} more</summary>
              <ol start={SHOWN + 1}>
                {g.entries.slice(SHOWN).map((e, i) => (
                  <li>
                    <span class="n">{String(SHOWN + i + 1).padStart(2, '0')}</span>
                    <a href={withBase(`/knowledge/${e.id}/`)} lang={e.data.lang}>
                      {e.data.title}
                    </a>
                    <time datetime={e.data.date.toISOString()}>{day(e.data.date)}</time>
                  </li>
                ))}
              </ol>
            </details>
          )}
        </article>
      ))}
    </div>
  ) : (
    <p class="empty">No series yet. Add a `series` line to an entry to start one.</p>
  )}
</ViewPage>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xl) var(--space-2xl);
    align-items: start;
  }

  .series {
    scroll-margin-top: calc(var(--nav-height) + var(--space-lg));
  }

  header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-md);
    padding-block: var(--space-md) var(--space-sm);
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  h2 {
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: var(--lh-snug);
  }

  .count {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  .bar {
    display: inline-block;
    width: 96px;
    height: 3px;
    border-radius: 2px;
    background: var(--color-rule);
  }

  .bar span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--color-accent);
  }

  ol {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-md);
    padding-block: var(--space-sm);
    border-top: var(--rule-hair) solid var(--color-rule);
    font-size: var(--text-sm);
  }

  .n,
  time {
    color: var(--color-muted);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  li a {
    overflow: hidden;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color var(--dur-short) var(--ease-out);
  }

  li a:hover {
    color: var(--color-accent);
  }

  details {
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  summary {
    display: flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-muted);
    font-size: var(--text-xs);
    cursor: pointer;
  }

  summary:hover {
    color: var(--color-accent);
  }

  .empty {
    padding-block: var(--space-xl);
    border-top: var(--rule-hair) solid var(--color-rule);
    color: var(--color-muted);
  }

  @media (max-width: 48rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
