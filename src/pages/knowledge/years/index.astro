---
import ViewPage from '../../../components/knowledge/ViewPage.astro';
import { getKnowledge } from '../../../data/knowledge';
import { groupByYear, slugify } from '../../../utils/content';
import { tagColour } from '../../../utils/tags';
import { withBase } from '../../../utils/url';

const years = groupByYear(await getKnowledge());
const md = (d: Date) =>
  `${String(d.getUTCMonth() + 1).padStart(2, '0')}/${String(d.getUTCDate()).padStart(2, '0')}`;
---

<ViewPage
  view="years"
  title="Years"
  note="Every entry in the order it was written, grouped by year."
>
  {years.length > 0 ? (
    years.map((y) => (
      <section class="year" aria-labelledby={`y${y.year}`}>
        <header>
          <h2 id={`y${y.year}`}>{y.year}</h2>
          <p>
            {y.entries.length} {y.entries.length === 1 ? 'entry' : 'entries'}
          </p>
        </header>
        <ol>
          {y.entries.map((e) => (
            <li>
              <time datetime={e.data.date.toISOString()}>{md(e.data.date)}</time>
              <a href={withBase(`/knowledge/${e.id}/`)} lang={e.data.lang}>
                {e.data.title}
              </a>
              <span class="tags" aria-label="Tags">
                {e.data.tags.slice(0, 3).map((t) => (
                  <a
                    class="chip hashtag"
                    href={withBase(`/knowledge/tags/${slugify(t)}/`)}
                    style={`--tag: var(--tag-${tagColour(t)})`}
                  >
                    #{t}
                  </a>
                ))}
              </span>
            </li>
          ))}
        </ol>
      </section>
    ))
  ) : (
    <p class="empty">Nothing has been written yet.</p>
  )}
</ViewPage>

<style>
  .year + .year {
    margin-top: var(--space-xl);
  }

  header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    padding-bottom: var(--space-sm);
  }

  h2 {
    font-size: var(--text-3xl);
    font-weight: 500;
    line-height: 1;
  }

  header p {
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  ol {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-md);
    padding-block: var(--space-sm);
    border-top: var(--rule-hair) solid var(--color-rule);
    font-size: var(--text-sm);
  }

  time {
    color: var(--color-muted);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  li > a {
    overflow: hidden;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color var(--dur-short) var(--ease-out);
  }

  li > a:hover {
    color: var(--color-accent);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-2xs);
  }

  .empty {
    padding-block: var(--space-xl);
    color: var(--color-muted);
  }

  @media (max-width: 40rem) {
    .tags {
      display: none;
    }

    li {
      grid-template-columns: 3rem minmax(0, 1fr);
    }
  }
</style>
