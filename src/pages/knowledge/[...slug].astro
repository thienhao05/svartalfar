---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Icon from '../../components/Icon.astro';
import EntryList from '../../components/knowledge/EntryList.astro';
import EntryMeta from '../../components/knowledge/EntryMeta.astro';
import MermaidRenderer from '../../components/knowledge/MermaidRenderer.astro';
import Toc from '../../components/knowledge/Toc.astro';
import { getKnowledge } from '../../data/knowledge';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { countWords, neighbours, readingMinutes, relatedEntries } from '../../utils/content';
import { buildToc } from '../../utils/toc';
import { withBase } from '../../utils/url';

export const getStaticPaths = (async () => {
  const all = await getKnowledge();
  return all.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, related: relatedEntries(entry, all), ...neighbours(entry, all) },
  }));
}) satisfies GetStaticPaths;

const { entry, related, older, newer } = Astro.props;
const { Content, headings } = await render(entry);
const toc = entry.data.toc ? buildToc(headings) : [];
const words = countWords(entry.body ?? '');
const minutes = readingMinutes(entry.body ?? '');
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  lang={entry.data.lang}
  type="article"
>
  <div class:list={['shell', 'frame', { solo: toc.length === 0 }]}>
    <article class="article">
      {entry.data.heroImage && (
        <div class="cover" aria-hidden="true">
          <Image
            src={entry.data.heroImage}
            alt=""
            width={1200}
            height={420}
            loading="eager"
            decoding="async"
          />
        </div>
      )}
      <header class="article-head">
        <h1 data-pagefind-meta="title">{entry.data.title}</h1>
        <p class="lede">{entry.data.description}</p>
        <div data-pagefind-ignore>
          <EntryMeta entry={entry} full words={words} readingMinutes={minutes} />
        </div>
        <span hidden data-pagefind-filter="area">
          {entry.data.area}
        </span>
        <span hidden data-pagefind-filter="lang">
          {entry.data.lang}
        </span>
      </header>

      {toc.length > 0 && (
        <details class="toc-inline" data-pagefind-ignore>
          <summary>On this page</summary>
          <Toc items={toc} />
        </details>
      )}

      <div class="prose">
        <Content />
      </div>

      {(older || newer) && (
        <nav class="neighbours" aria-label="More entries" data-pagefind-ignore>
          {newer && (
            <a class="card newer" href={withBase(`/knowledge/${newer.id}/`)} rel="prev">
              <span class="dir">
                <Icon name="arrow-left" size={14} /> Newer entry
              </span>
              <strong lang={newer.data.lang}>{newer.data.title}</strong>
            </a>
          )}
          {older && (
            <a class="card older" href={withBase(`/knowledge/${older.id}/`)} rel="next">
              <span class="dir">
                Older entry <Icon name="arrow-right" size={14} />
              </span>
              <strong lang={older.data.lang}>{older.data.title}</strong>
            </a>
          )}
        </nav>
      )}

      {related.length > 0 && (
        <section class="related" aria-labelledby="related-title" data-pagefind-ignore>
          <h2 id="related-title">Related in the archive</h2>
          <EntryList entries={related} compact />
        </section>
      )}
    </article>

    {toc.length > 0 && (
      <aside class="toc-rail" aria-label="Reading tools" data-pagefind-ignore>
        <Toc items={toc} />
      </aside>
    )}
  </div>
  <MermaidRenderer />
</BaseLayout>

<style>
  .solo {
    grid-template-columns: minmax(0, var(--col-main));
    justify-content: center;
  }

  .article {
    min-width: 0;
  }

  /* The cover opens the page and fades into the title below it. */
  .cover {
    aspect-ratio: 20 / 7;
    margin-bottom: calc(var(--space-xl) * -1);
    overflow: hidden;
    border-radius: var(--radius-card);
    opacity: 0.6;
    -webkit-mask-image: linear-gradient(to bottom, #000 25%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 25%, transparent 100%);
  }

  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Soft focus; the slight scale keeps blurred edges inside the frame. */
    filter: blur(10px);
    transform: scale(1.1);
  }

  .article-head {
    display: grid;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-lg);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  h1 {
    font-size: var(--text-display);
    font-weight: 500;
    letter-spacing: var(--tracking-display);
    line-height: var(--lh-heading);
    max-width: 32ch;
  }

  .lede {
    max-width: 64ch;
    color: var(--color-ink-2);
    font-size: var(--text-md);
    line-height: var(--lh-copy);
  }

  .toc-rail {
    position: sticky;
    top: calc(var(--nav-height) + var(--space-xl));
    max-height: calc(100dvh - var(--nav-height) - var(--space-2xl));
    overflow-y: auto;
    /* A long outline still scrolls, but without a visible bar. */
    scrollbar-width: none;
  }

  .toc-rail::-webkit-scrollbar {
    display: none;
  }

  .toc-inline {
    display: none;
    margin-bottom: var(--space-xl);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-card);
    background: var(--color-paper-2);
  }

  .toc-inline summary {
    min-height: 44px;
    display: flex;
    align-items: center;
    color: var(--color-ink-2);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
  }

  .toc-inline :global(.toc h2) {
    display: none;
  }

  .neighbours {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-sm);
    margin-top: var(--space-3xl);
  }

  .card {
    display: grid;
    align-content: start;
    gap: var(--space-2xs);
    padding: var(--space-sm) var(--space-md);
    border: 1.5px solid color-mix(in oklab, var(--color-accent) 38%, var(--color-rule-strong));
    border-radius: var(--radius-card);
    background: var(--color-paper-2);
    box-shadow: 0 1px 0 color-mix(in oklab, var(--color-accent) 14%, transparent);
    text-decoration: none;
    transition:
      border-color var(--dur-short) var(--ease-out),
      background-color var(--dur-short) var(--ease-out),
      transform var(--dur-short) var(--ease-out);
  }

  .card:hover {
    border-color: var(--color-accent);
    background: color-mix(in oklab, var(--color-accent) 8%, var(--color-paper-2));
    transform: translateY(-2px);
    color: var(--color-ink);
  }

  .card:active {
    transform: translateY(0);
  }

  .dir {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .dir :global(svg) {
    transition: transform var(--dur-short) var(--ease-out);
  }

  .newer:hover .dir :global(svg) {
    transform: translateX(-4px);
  }

  .older:hover .dir :global(svg) {
    transform: translateX(4px);
  }

  .card strong {
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: var(--lh-heading);
  }

  /* One neighbour sits on its own side; the older entry always points right. */
  .older {
    grid-column: 2;
    justify-items: end;
    text-align: right;
  }

  .older:only-child {
    grid-column: 2;
  }

  @media (max-width: 40rem) {
    .neighbours {
      grid-template-columns: minmax(0, 1fr);
    }

    .older,
    .older:only-child {
      grid-column: 1;
    }
  }

  .related {
    margin-top: var(--space-3xl);
  }

  .related h2 {
    margin-bottom: var(--space-sm);
    font-size: var(--text-xl);
    font-weight: 500;
  }

  @media (max-width: 60rem) {
    .toc-rail {
      display: none;
    }

    .toc-inline {
      display: block;
    }
  }
</style>
